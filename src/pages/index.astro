---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import Butoscope from '../components/Butoscope.astro';
import RecordsTimeline from '../components/RecordsTimeline.astro';
import GoalList from '../components/GoalList.astro';
import Trophies from '../components/Trophies.astro';
---

<Layout 
  title="Lamine Yamal — Statistiques Officielles, Butoscope & Records | FC Barcelone"
  description="Interface de statistiques moderne et épurée dédiée à Lamine Yamal. Cartographie interactive des buts (Butoscope), records de précocité et palmarès officiel."
>
  <Header />
  <main class="space-y-12 sm:space-y-16 pb-16">
    <Hero />
    <Butoscope />
    <GoalList />
    <RecordsTimeline />
    <Trophies />
  </main>
</Layout>
