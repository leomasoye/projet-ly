---
import { getValidatedGoals } from '../lib/data-validator';
import { formatDateFr } from '../lib/utils';

const goals = getValidatedGoals();
const initialGoal = goals[3] || goals[0]; // France Euro 2024 goal by default
---

<section id="butoscope" class="py-12 sm:py-16 px-4 md:px-8 bg-white border-y border-[#E2E8F0]">
  <div class="max-w-7xl mx-auto">
    
    <!-- En-tête de Section Sofascore / FBref Style -->
    <div class="flex flex-col md:flex-row md:items-end justify-between gap-4 mb-8">
      <div>
        <div class="flex items-center gap-2 text-xs font-semibold text-[#004D98] uppercase tracking-wider mb-2">
          <span class="w-2 h-2 rounded-full bg-[#004D98]"></span>
          <span>Cartographie Tactique & Balistique</span>
          <span class="text-[#CBD5E1]">•</span>
          <span class="text-[#64748B]">Saison 2023-2025</span>
        </div>
        <h2 class="text-2xl sm:text-3xl md:text-4xl font-extrabold text-[#0F172A] tracking-tight leading-none">
          Le Butoscope Interactif
        </h2>
        <p class="mt-2 text-sm text-[#64748B] max-w-2xl leading-relaxed">
          Position exacte, angle et distance de chaque réalisation de Lamine Yamal. Cliquez ou survolez un point d'impact sur le terrain pour afficher l'analyse tactique et charger le replay officiel.
        </p>
      </div>

      <!-- Légende Sobre des Points d'Impact -->
      <div class="flex flex-wrap items-center gap-3 text-xs bg-[#F8FAFC] border border-[#E2E8F0] px-3.5 py-2 rounded-lg self-start md:self-auto shadow-xs">
        <div class="flex items-center gap-1.5">
          <span class="w-3 h-3 rounded-full bg-[#A50044] ring-2 ring-white shadow-xs"></span>
          <span class="text-[#475569] font-medium">But Officiel</span>
        </div>
        <div class="flex items-center gap-1.5">
          <span class="w-3 h-3 rounded-full bg-[#EDBB00] ring-2 ring-white shadow-xs"></span>
          <span class="text-[#475569] font-medium">Record / Historique</span>
        </div>
        <div class="flex items-center gap-1.5">
          <span class="w-3 h-3 rounded-full bg-[#004D98] ring-2 ring-white shadow-xs"></span>
          <span class="text-[#475569] font-medium">Frappe Décisive</span>
        </div>
      </div>
    </div>

    <!-- Grille Principale : Terrain Tactique (Gauche) + Fiche d'Analyse (Droite) -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
      
      <!-- 1. Demi-Terrain de Football Épuré Pastel (7 colonnes) -->
      <div class="lg:col-span-7 bg-[#F8FAFC] rounded-2xl border border-[#E2E8F0] p-4 sm:p-6 shadow-xs select-none">
        
        <!-- En-tête technique du terrain -->
        <div class="flex items-center justify-between text-xs text-[#64748B] font-medium mb-3 pb-2.5 border-b border-[#E2E8F0]">
          <span class="flex items-center gap-1.5">
            <span class="w-1.5 h-1.5 rounded-full bg-[#004D98]"></span>
            Zone d'attaque (Camp adverse)
          </span>
          <span class="text-[#004D98] font-semibold">Demi-terrain 2D • Métriques Opta</span>
          <span>Vue Cible</span>
        </div>

        <!-- Conteneur Terrain Pastel / Gazon Doux -->
        <div class="relative w-full aspect-[4/5] sm:aspect-[1/1] max-w-lg mx-auto bg-[#F0FDF4] rounded-xl border border-[#86EFAC]/60 overflow-hidden shadow-inner">
          
          <!-- Lignes géométriques du terrain SVG -->
          <svg class="absolute inset-0 w-full h-full pointer-events-none stroke-[#4ADE80] stroke-[1.5]" viewBox="0 0 100 100" preserveAspectRatio="none">
            <!-- Pelouse : Tonte en bandes pastel subtiles et douces -->
            <rect x="0" y="0" width="100" height="20" fill="#F0FDF4" />
            <rect x="0" y="20" width="100" height="20" fill="#E7F9ED" />
            <rect x="0" y="40" width="100" height="20" fill="#F0FDF4" />
            <rect x="0" y="60" width="100" height="20" fill="#E7F9ED" />
            <rect x="0" y="80" width="100" height="20" fill="#F0FDF4" />

            <!-- Ligne de but (Haut) -->
            <line x1="0" y1="2" x2="100" y2="2" class="stroke-[#22C55E] stroke-2" />

            <!-- Cage de but (extérieur) -->
            <rect x="42" y="0" width="16" height="2" fill="#004D98" class="stroke-[#004D98] stroke-1" />

            <!-- Surface de but (6 mètres) -->
            <rect x="36" y="2" width="28" height="8" fill="none" class="stroke-[#4ADE80]" />

            <!-- Surface de réparation (16.50 mètres) -->
            <rect x="20" y="2" width="60" height="26" fill="none" class="stroke-[#4ADE80]" />

            <!-- Point de penalty (11 mètres) -->
            <circle cx="50" cy="18" r="0.9" fill="#16A34A" />

            <!-- Arc de cercle de surface -->
            <path d="M 38 28 A 12 12 0 0 0 62 28" fill="none" class="stroke-[#4ADE80]" />

            <!-- Ligne médiane (Bas) -->
            <line x1="0" y1="98" x2="100" y2="98" class="stroke-[#4ADE80] stroke-2" />

            <!-- Rond central (demi-cercle) -->
            <path d="M 32 98 A 18 18 0 0 1 68 98" fill="none" class="stroke-[#4ADE80]" />
            <circle cx="50" cy="98" r="1" fill="#16A34A" />
          </svg>

          <!-- Points d'Impact Cliquables des Buts (Pastilles Grenat bordées de blanc) -->
          <div id="pitch-pins-container" class="absolute inset-0">
            {goals.map((goal) => {
              const topPos = Math.max(3, Math.min(95, 100 - (goal.coordinates.x - 45) * 1.8));
              const leftPos = Math.max(5, Math.min(95, goal.coordinates.y));
              const isInitial = goal.id === initialGoal.id;

              const pinBg = 
                goal.importance === 'Historique' ? 'bg-[#EDBB00]' :
                goal.importance === 'Décisif' ? 'bg-[#004D98]' :
                'bg-[#A50044]';

              return (
                <button
                  type="button"
                  data-goal-id={goal.id}
                  class={`pitch-pin absolute -translate-x-1/2 -translate-y-1/2 w-7 h-7 sm:w-8 sm:h-8 rounded-full flex items-center justify-center font-bold text-[11px] text-white ring-2 ring-white shadow-md cursor-pointer transition-all duration-150 z-20 ${pinBg} ${isInitial ? 'ring-4 ring-[#004D98] scale-125 z-30 shadow-lg' : 'hover:scale-125 hover:z-30 hover:ring-3 hover:ring-[#004D98]'}`}
                  style={`top: ${topPos}%; left: ${leftPos}%;`}
                  title={`${goal.opponent} (${goal.minute}') — ${goal.competition}`}
                  aria-label={`But contre ${goal.opponent} à la ${goal.minute}e minute`}
                >
                  <span class="leading-none tabular-nums">{goal.minute}'</span>
                </button>
              );
            })}
          </div>

          <!-- Sens de progression de l'attaque -->
          <div class="absolute bottom-2 left-3 text-[10px] font-semibold text-[#16A34A] flex items-center gap-1 pointer-events-none bg-white/80 px-2 py-0.5 rounded backdrop-blur-xs border border-[#86EFAC]/40">
            <span>▲ Sens d'attaque vers le but adverse</span>
          </div>
        </div>

        <!-- Sélecteur rapide des réalisations sous le terrain -->
        <div class="mt-4 pt-3.5 border-t border-[#E2E8F0]">
          <div class="text-[11px] font-semibold text-[#64748B] uppercase tracking-wider mb-2">
            Sélection directe d'un but ({goals.length} répertoriés) :
          </div>
          <div class="flex gap-1.5 overflow-x-auto pb-1 scrollbar-thin">
            {goals.map((g) => (
              <button
                type="button"
                data-goal-select={g.id}
                class="goal-pill-btn shrink-0 px-2.5 py-1 text-xs font-medium rounded-md border border-[#E2E8F0] bg-white text-[#475569] hover:border-[#004D98] hover:text-[#004D98] transition-colors shadow-2xs"
              >
                {g.opponent} ({g.minute}')
              </button>
            ))}
          </div>
        </div>

      </div>

      <!-- 2. Fiche Statistique Sobre & Façade Vidéo (5 colonnes) -->
      <div class="lg:col-span-5 bg-white rounded-2xl border border-[#E2E8F0] p-6 shadow-xs flex flex-col justify-between min-h-[520px]">
        
        <div>
          <!-- Badge d'importance & Contexte match -->
          <div class="flex items-center justify-between gap-2 border-b border-[#E2E8F0] pb-3 mb-4">
            <span id="detail-importance" class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-semibold bg-[#fdf2f5] text-[#A50044] border border-[#A50044]/20">
              {initialGoal.importance}
            </span>
            <span id="detail-competition" class="text-xs font-semibold text-[#004D98]">
              {initialGoal.competition} • {initialGoal.season}
            </span>
          </div>

          <!-- Titre du But / Adversaire -->
          <div class="mb-4">
            <div class="text-xs text-[#64748B] font-medium mb-1" id="detail-date">
              {formatDateFr(initialGoal.date)} ({initialGoal.homeAway})
            </div>
            <h3 id="detail-opponent" class="text-2xl sm:text-3xl font-extrabold text-[#0F172A] tracking-tight leading-tight">
              vs {initialGoal.opponent}
            </h3>
          </div>

          <!-- Métriques Clés du But (Score / Minute) -->
          <div class="grid grid-cols-3 gap-2.5 my-4 text-center">
            <div class="border border-[#E2E8F0] rounded-lg p-2.5 bg-[#F8FAFC]">
              <div class="text-[10px] font-semibold text-[#64748B] uppercase tracking-wider">Minute</div>
              <div id="detail-minute" class="text-xl font-extrabold text-[#004D98] tabular-nums mt-0.5">{initialGoal.minute}'</div>
            </div>
            <div class="border border-[#E2E8F0] rounded-lg p-2.5 bg-[#F8FAFC]">
              <div class="text-[10px] font-semibold text-[#64748B] uppercase tracking-wider">Score lors du but</div>
              <div id="detail-score" class="text-xl font-bold text-[#0F172A] tabular-nums mt-0.5">{initialGoal.score}</div>
            </div>
            <div class="border border-[#E2E8F0] rounded-lg p-2.5 bg-[#F8FAFC]">
              <div class="text-[10px] font-semibold text-[#64748B] uppercase tracking-wider">Résultat Final</div>
              <div id="detail-final" class="text-xl font-bold text-[#0F172A] tabular-nums mt-0.5">{initialGoal.finalScore}</div>
            </div>
          </div>

          <!-- Fiche Technique : Type de Frappe & Passeur -->
          <div class="space-y-2 text-xs rounded-lg bg-[#F8FAFC] p-3.5 border border-[#E2E8F0] mb-4">
            <div class="flex items-center justify-between">
              <span class="text-[#64748B] font-medium">Type de geste :</span>
              <span id="detail-type" class="text-[#0F172A] font-semibold">{initialGoal.goalType}</span>
            </div>
            <div class="flex items-center justify-between">
              <span class="text-[#64748B] font-medium">Passeur décisif :</span>
              <span id="detail-assist" class="text-[#004D98] font-semibold">{initialGoal.assist || 'Action individuelle'}</span>
            </div>
            <div class="flex items-center justify-between">
              <span class="text-[#64748B] font-medium">Coordonnées tactiques :</span>
              <span id="detail-coords" class="text-[#64748B] font-mono">X: {initialGoal.coordinates.x}m / Y: {initialGoal.coordinates.y}m</span>
            </div>
          </div>

          <!-- Description Tactique -->
          <p id="detail-description" class="text-sm text-[#475569] leading-relaxed border-l-3 border-[#004D98] pl-3.5 mb-5">
            {initialGoal.description}
          </p>
        </div>

        <!-- Façade Vidéo Sécurisée (Zero iframe au chargement) -->
        <div class="pt-4 border-t border-[#E2E8F0]">
          <div class="text-xs text-[#64748B] font-medium mb-2.5 flex items-center justify-between">
            <span class="flex items-center gap-1.5">
              <span class="w-1.5 h-1.5 rounded-full bg-[#A50044]"></span>
              Extrait Vidéo Officiel
            </span>
            <div class="flex items-center gap-2">
              <a
                id="video-external-btn"
                href={`https://www.youtube.com/results?search_query=${encodeURIComponent('But Lamine Yamal vs ' + initialGoal.opponent + ' ' + initialGoal.competition)}`}
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex items-center gap-1 px-2 py-0.5 rounded text-[11px] font-semibold text-[#A50044] bg-[#fdf2f5] hover:bg-[#A50044] hover:text-white border border-[#A50044]/20 transition-colors shadow-2xs"
                title="Ouvrir la recherche vidéo officielle sur YouTube"
              >
                <span>Voir sur YouTube</span>
                <span class="text-[9px]">↗</span>
              </a>
              <span class="text-emerald-600 font-semibold text-[11px] hidden sm:inline">● Sécurisé</span>
            </div>
          </div>

          <!-- Lecteur / Conteneur Façade Dynamique -->
          <div id="video-wrapper" class="relative w-full aspect-video bg-[#0F172A] rounded-xl border border-[#E2E8F0] overflow-hidden shadow-xs flex flex-col items-center justify-center">
            
            <!-- Façade Statique (Bouton de Déclenchement) -->
            <div id="video-facade" class="absolute inset-0 flex flex-col items-center justify-center p-6 text-center bg-gradient-to-t from-black/80 via-black/40 to-black/20 hover:from-black/70 transition-colors cursor-pointer group">
              
              <!-- Bouton Play Sobre Barça -->
              <div class="w-12 h-12 rounded-full bg-white text-[#004D98] flex items-center justify-center shadow-lg group-hover:scale-110 group-hover:bg-[#A50044] group-hover:text-white transition-all mb-2.5">
                <svg class="w-5 h-5 fill-current translate-x-0.5" viewBox="0 0 24 24">
                  <path d="M8 5v14l11-7z" />
                </svg>
              </div>

              <span class="text-white text-sm font-bold tracking-tight group-hover:text-[#EDBB00] transition-colors">
                Visionner le Replay Vidéo
              </span>
              <span class="text-white/70 text-[11px] mt-0.5">
                Diffusion sandboxée • 0 cookie tiers avant clic
              </span>
            </div>

            <!-- Conteneur Iframe (injecté uniquement à la demande) -->
            <div id="video-embed-container" class="hidden w-full h-full"></div>
          </div>
        </div>

      </div>

    </div>

  </div>
</section>

<!-- Données JSON sérialisées pour la réactivité sans appel réseau client -->
<script id="goals-raw-data" type="application/json" set:html={JSON.stringify(goals)} />

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const rawDataEl = document.getElementById('goals-raw-data');
    if (!rawDataEl) return;

    interface GoalItem {
      id: string;
      opponent: string;
      competition: string;
      season: string;
      date: string;
      homeAway: string;
      minute: number;
      score: string;
      finalScore: string;
      goalType: string;
      assist: string | null;
      coordinates: { x: number; y: number };
      videoId: string;
      videoUrl: string;
      description: string;
      importance: string;
      tags: string[];
    }

    const allGoals: GoalItem[] = JSON.parse(rawDataEl.textContent || '[]');
    let currentGoal = allGoals[3] || allGoals[0];

    // Éléments du DOM
    const detailImportance = document.getElementById('detail-importance');
    const detailCompetition = document.getElementById('detail-competition');
    const detailDate = document.getElementById('detail-date');
    const detailOpponent = document.getElementById('detail-opponent');
    const detailMinute = document.getElementById('detail-minute');
    const detailScore = document.getElementById('detail-score');
    const detailFinal = document.getElementById('detail-final');
    const detailType = document.getElementById('detail-type');
    const detailAssist = document.getElementById('detail-assist');
    const detailCoords = document.getElementById('detail-coords');
    const detailDescription = document.getElementById('detail-description');
    
    const videoFacade = document.getElementById('video-facade');
    const videoEmbedContainer = document.getElementById('video-embed-container');
    const videoExternalBtn = document.getElementById('video-external-btn') as HTMLAnchorElement | null;
    const pitchPins = document.querySelectorAll<HTMLButtonElement>('.pitch-pin');
    const pillButtons = document.querySelectorAll<HTMLButtonElement>('.goal-pill-btn');

    function selectGoal(goal: GoalItem) {
      currentGoal = goal;

      if (detailImportance) detailImportance.textContent = goal.importance;
      if (detailCompetition) detailCompetition.textContent = `${goal.competition} • ${goal.season}`;
      if (detailDate) detailDate.textContent = `${goal.date} (${goal.homeAway})`;
      if (detailOpponent) detailOpponent.textContent = `vs ${goal.opponent}`;
      if (detailMinute) detailMinute.textContent = `${goal.minute}'`;
      if (detailScore) detailScore.textContent = goal.score;
      if (detailFinal) detailFinal.textContent = goal.finalScore;
      if (detailType) detailType.textContent = goal.goalType;
      if (detailAssist) detailAssist.textContent = goal.assist || 'Action individuelle';
      if (detailCoords) detailCoords.textContent = `X: ${goal.coordinates.x}m / Y: ${goal.coordinates.y}m`;
      if (detailDescription) detailDescription.textContent = goal.description;

      // Mettre à jour le lien de secours direct YouTube
      if (videoExternalBtn) {
        videoExternalBtn.href = `https://www.youtube.com/results?search_query=${encodeURIComponent('But Lamine Yamal vs ' + goal.opponent + ' ' + goal.competition)}`;
        videoExternalBtn.title = `Regarder le but contre ${goal.opponent} sur YouTube`;
      }

      // Réinitialiser la vidéo si elle tournait
      if (videoFacade && videoEmbedContainer) {
        videoEmbedContainer.innerHTML = '';
        videoEmbedContainer.classList.add('hidden');
        videoFacade.classList.remove('hidden');
      }

      // Mise à jour visuelle des balises sur le terrain
      pitchPins.forEach((pin) => {
        if (pin.dataset.goalId === goal.id) {
          pin.classList.add('ring-4', 'ring-[#004D98]', 'scale-125', 'z-30', 'shadow-lg');
          pin.classList.remove('ring-2', 'ring-white');
        } else {
          pin.classList.remove('ring-4', 'ring-[#004D98]', 'scale-125', 'z-30', 'shadow-lg');
          pin.classList.add('ring-2', 'ring-white');
        }
      });

      // Mise à jour des pilules sous le terrain
      pillButtons.forEach((btn) => {
        if (btn.dataset.goalSelect === goal.id) {
          btn.classList.add('bg-[#004D98]', 'text-white', 'border-[#004D98]');
          btn.classList.remove('bg-white', 'text-[#475569]', 'border-[#E2E8F0]');
        } else {
          btn.classList.remove('bg-[#004D98]', 'text-white', 'border-[#004D98]');
          btn.classList.add('bg-white', 'text-[#475569]', 'border-[#E2E8F0]');
        }
      });
    }

    // Gestion des clics et survols sur les pastilles du terrain
    pitchPins.forEach((pin) => {
      pin.addEventListener('click', () => {
        const goalId = pin.dataset.goalId;
        const target = allGoals.find((g) => g.id === goalId);
        if (target) selectGoal(target);
      });
      pin.addEventListener('mouseenter', () => {
        const goalId = pin.dataset.goalId;
        const target = allGoals.find((g) => g.id === goalId);
        if (target) selectGoal(target);
      });
    });

    // Gestion des boutons pilules
    pillButtons.forEach((btn) => {
      btn.addEventListener('click', () => {
        const goalId = btn.dataset.goalSelect;
        const target = allGoals.find((g) => g.id === goalId);
        if (target) selectGoal(target);
      });
    });

    // Clic sur Façade Vidéo : instanciation de l'iframe sandboxée
    if (videoFacade && videoEmbedContainer) {
      videoFacade.addEventListener('click', () => {
        videoFacade.classList.add('hidden');
        videoEmbedContainer.classList.remove('hidden');

        const iframe = document.createElement('iframe');
        iframe.setAttribute('src', `https://www.youtube-nocookie.com/embed/${encodeURIComponent(currentGoal.videoId)}?autoplay=1&rel=0`);
        iframe.setAttribute('title', `Lamine Yamal vs ${currentGoal.opponent}`);
        iframe.setAttribute('sandbox', 'allow-scripts allow-same-origin allow-presentation allow-popups allow-forms');
        iframe.setAttribute('loading', 'lazy');
        iframe.setAttribute('referrerpolicy', 'strict-origin-when-cross-origin');
        iframe.setAttribute('allow', 'accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture');
        iframe.setAttribute('allowfullscreen', 'true');
        iframe.className = 'w-full h-full rounded-xl';

        videoEmbedContainer.innerHTML = '';
        videoEmbedContainer.appendChild(iframe);
      });
    }

    // Écouteur global pour sélection externe
    window.addEventListener('select-goal', ((event: CustomEvent<{ goalId: string }>) => {
      const target = allGoals.find((g) => g.id === event.detail.goalId);
      if (target) {
        selectGoal(target);
        document.getElementById('butoscope')?.scrollIntoView({ behavior: 'smooth' });
      }
    }) as EventListener);
  });
</script>
