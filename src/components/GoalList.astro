---
import { getValidatedGoals } from '../lib/data-validator';
import { formatDateFr } from '../lib/utils';

const goals = getValidatedGoals();

// Extraire les options uniques pour les filtres
const competitions = Array.from(new Set(goals.map((g) => g.competition)));
const seasons = Array.from(new Set(goals.map((g) => g.season)));
---

<section id="buts" class="py-12 sm:py-16 px-4 md:px-8">
  <div class="max-w-7xl mx-auto">
    
    <!-- En-tête de Section -->
    <div class="flex flex-col md:flex-row md:items-end justify-between gap-4 mb-8">
      <div>
        <div class="flex items-center gap-2 text-xs font-semibold text-[#004D98] uppercase tracking-wider mb-2">
          <span class="w-2 h-2 rounded-full bg-[#004D98]"></span>
          <span>Base de Données Complète</span>
          <span class="text-[#CBD5E1]">•</span>
          <span class="text-[#64748B]">Tableau de Performance</span>
        </div>
        <h2 class="text-2xl sm:text-3xl md:text-4xl font-extrabold text-[#0F172A] tracking-tight leading-none">
          Registre Détaillé des Buts
        </h2>
        <p class="mt-2 text-sm text-[#64748B] max-w-xl leading-relaxed">
          Tableau statistique exhaustif, triable par colonne et paginé. Cliquez sur « Visualiser » pour pointer la réalisation sur le terrain 2D du Butoscope.
        </p>
      </div>

      <!-- Compteur dynamique de résultats -->
      <div class="bg-white border border-[#E2E8F0] px-4 py-2 rounded-lg text-xs font-medium text-[#475569] shadow-xs self-start md:self-auto">
        <span>Buts répertoriés :</span>
        <span id="filtered-count" class="font-bold text-[#004D98] text-sm tabular-nums ml-1.5">{goals.length}</span>
        <span class="text-[#94A3B8]"> / {goals.length}</span>
      </div>
    </div>

    <!-- Barre de Contrôles & Filtres Rapides (Pill Buttons) -->
    <div class="bg-white rounded-xl border border-[#E2E8F0] p-4 sm:p-5 mb-6 shadow-xs flex flex-wrap items-center justify-between gap-4">
      
      <!-- Filtre par Compétition -->
      <div class="flex flex-wrap items-center gap-1.5">
        <span class="text-xs font-semibold text-[#64748B] mr-1 uppercase tracking-wider">Compétition :</span>
        <button
          type="button"
          data-filter-competition="all"
          class="filter-comp-btn px-3 py-1 rounded-md text-xs font-semibold bg-[#004D98] text-white shadow-2xs transition-colors"
        >
          Toutes
        </button>
        {competitions.map((comp) => (
          <button
            type="button"
            data-filter-competition={comp}
            class="filter-comp-btn px-3 py-1 rounded-md text-xs font-medium bg-[#F8FAFC] text-[#475569] border border-[#E2E8F0] hover:border-[#004D98] hover:text-[#004D98] transition-colors"
          >
            {comp}
          </button>
        ))}
      </div>

      <!-- Filtre par Saison -->
      <div class="flex flex-wrap items-center gap-1.5">
        <span class="text-xs font-semibold text-[#64748B] mr-1 uppercase tracking-wider">Saison :</span>
        <button
          type="button"
          data-filter-season="all"
          class="filter-season-btn px-3 py-1 rounded-md text-xs font-semibold bg-[#004D98] text-white shadow-2xs transition-colors"
        >
          Toutes
        </button>
        {seasons.map((s) => (
          <button
            type="button"
            data-filter-season={s}
            class="filter-season-btn px-3 py-1 rounded-md text-xs font-medium bg-[#F8FAFC] text-[#475569] border border-[#E2E8F0] hover:border-[#004D98] hover:text-[#004D98] transition-colors"
          >
            {s}
          </button>
        ))}
      </div>

    </div>

    <!-- TABLEAU DE STATISTIQUES LISIBLE, TRIABLE ET PAGINÉ (Type Sofascore / FBref) -->
    <div class="bg-white rounded-2xl border border-[#E2E8F0] shadow-xs overflow-hidden">
      <div class="overflow-x-auto">
        <table class="w-full text-left border-collapse text-xs sm:text-sm">
          
          <!-- En-tête de Tableau avec colonnes triables -->
          <thead>
            <tr class="bg-[#F8FAFC] border-b border-[#E2E8F0] text-[11px] font-semibold text-[#64748B] uppercase tracking-wider select-none">
              <th scope="col" class="py-3.5 px-4 sm:px-6 cursor-pointer hover:text-[#004D98] transition-colors" id="th-date">
                <div class="flex items-center gap-1">
                  <span>Date</span>
                  <span class="text-[#94A3B8] text-[10px]" id="sort-date-icon">↕</span>
                </div>
              </th>
              <th scope="col" class="py-3.5 px-4">Compétition</th>
              <th scope="col" class="py-3.5 px-4">Adversaire</th>
              <th scope="col" class="py-3.5 px-4 cursor-pointer hover:text-[#004D98] transition-colors" id="th-minute">
                <div class="flex items-center gap-1">
                  <span>Minute</span>
                  <span class="text-[#94A3B8] text-[10px]" id="sort-minute-icon">↕</span>
                </div>
              </th>
              <th scope="col" class="py-3.5 px-4">Score</th>
              <th scope="col" class="py-3.5 px-4">Geste / Type</th>
              <th scope="col" class="py-3.5 px-4">Passeur</th>
              <th scope="col" class="py-3.5 px-4 text-right pr-6">Action</th>
            </tr>
          </thead>

          <!-- Corps du Tableau avec lignes alternées blanc / gris très clair -->
          <tbody id="goals-table-body" class="divide-y divide-[#E2E8F0]">
            {goals.map((goal, index) => {
              const isEven = index % 2 === 0;
              const rowBg = isEven ? 'bg-white' : 'bg-[#F8FAFC]/75';
              
              const isEuro = goal.competition.includes('Euro');
              const isLiga = goal.competition.includes('Liga');
              const isChampions = goal.competition.includes('Champions');
              
              const compBadgeClass = 
                isEuro ? 'bg-[#fef9e6] text-[#A16207] border-[#EDBB00]/30' :
                isChampions ? 'bg-[#edf4fb] text-[#004D98] border-[#004D98]/20' :
                isLiga ? 'bg-[#fdf2f5] text-[#A50044] border-[#A50044]/20' :
                'bg-[#F1F5F9] text-[#475569] border-[#E2E8F0]';

              return (
                <tr 
                  class={`goal-table-row ${rowBg} hover:bg-[#F1F5F9] transition-colors group`}
                  data-competition={goal.competition}
                  data-season={goal.season}
                  data-goal-id={goal.id}
                  data-date={goal.date}
                  data-minute={goal.minute}
                >
                  <!-- Date -->
                  <td class="py-3.5 px-4 sm:px-6 font-medium text-[#0F172A] whitespace-nowrap">
                    {formatDateFr(goal.date)}
                  </td>

                  <!-- Compétition & Saison (Badges compacts et alignés) -->
                  <td class="py-3.5 px-4 whitespace-nowrap">
                    <span class={`inline-flex items-center gap-1 px-2 py-0.5 rounded text-[11px] font-semibold border ${compBadgeClass}`}>
                      {goal.competition}
                      <span class="opacity-60 text-[10px]">• {goal.season}</span>
                    </span>
                  </td>

                  <!-- Adversaire & Lieu -->
                  <td class="py-3.5 px-4 whitespace-nowrap">
                    <div class="flex items-center gap-2">
                      <span class="font-bold text-[#0F172A] group-hover:text-[#004D98] transition-colors">
                        {goal.opponent}
                      </span>
                      <span class={`text-[10px] font-semibold px-1.5 py-0.2 rounded ${goal.homeAway === 'DOM' ? 'bg-[#edf4fb] text-[#004D98]' : 'bg-[#F1F5F9] text-[#64748B]'}`}>
                        {goal.homeAway}
                      </span>
                    </div>
                  </td>

                  <!-- Minute -->
                  <td class="py-3.5 px-4 whitespace-nowrap font-bold text-[#004D98] tabular-nums">
                    {goal.minute}'
                  </td>

                  <!-- Score -->
                  <td class="py-3.5 px-4 whitespace-nowrap tabular-nums font-semibold text-[#0F172A]">
                    {goal.score} <span class="text-[#94A3B8] font-normal text-xs">({goal.finalScore})</span>
                  </td>

                  <!-- Geste -->
                  <td class="py-3.5 px-4 whitespace-nowrap text-[#475569]">
                    {goal.goalType}
                  </td>

                  <!-- Passeur -->
                  <td class="py-3.5 px-4 whitespace-nowrap text-[#475569]">
                    {goal.assist ? (
                      <span class="text-[#004D98] font-medium">{goal.assist}</span>
                    ) : (
                      <span class="text-[#94A3B8] italic text-xs">Individuel</span>
                    )}
                  </td>

                  <!-- Bouton Action / Visualiser -->
                  <td class="py-3.5 px-4 text-right pr-6 whitespace-nowrap">
                    <button
                      type="button"
                      data-trigger-goal={goal.id}
                      class="trigger-butoscope-btn inline-flex items-center gap-1.5 px-3 py-1 rounded-md text-xs font-semibold bg-[#edf4fb] text-[#004D98] hover:bg-[#004D98] hover:text-white transition-all shadow-2xs"
                    >
                      <span>Butoscope</span>
                      <span class="text-[10px]">↗</span>
                    </button>
                  </td>
                </tr>
              );
            })}
          </tbody>
        </table>
      </div>

      <!-- Barre de Pagination Propre & Informations -->
      <div class="py-3.5 px-6 border-t border-[#E2E8F0] bg-[#F8FAFC] flex flex-col sm:flex-row items-center justify-between gap-4 text-xs text-[#64748B]">
        <div>
          Affichage des éléments <strong id="pagination-start" class="text-[#0F172A]">1</strong> à <strong id="pagination-end" class="text-[#0F172A]">6</strong> sur <strong id="pagination-total" class="text-[#0F172A]">{goals.length}</strong>
        </div>

        <div class="flex items-center gap-2">
          <button
            type="button"
            id="btn-prev-page"
            class="px-3 py-1.5 rounded-md border border-[#E2E8F0] bg-white text-[#475569] font-medium hover:bg-[#F1F5F9] disabled:opacity-40 disabled:cursor-not-allowed transition-colors"
          >
            ← Précédent
          </button>
          <div id="page-numbers-container" class="flex items-center gap-1">
            <!-- Injecté par script -->
          </div>
          <button
            type="button"
            id="btn-next-page"
            class="px-3 py-1.5 rounded-md border border-[#E2E8F0] bg-white text-[#475569] font-medium hover:bg-[#F1F5F9] disabled:opacity-40 disabled:cursor-not-allowed transition-colors"
          >
            Suivant →
          </button>
        </div>
      </div>

    </div>

    <!-- Message aucun résultat -->
    <div id="no-results" class="hidden bg-white rounded-xl border border-[#E2E8F0] p-8 text-center my-6 shadow-xs">
      <div class="w-10 h-10 rounded-full bg-[#fdf2f5] text-[#A50044] flex items-center justify-center mx-auto mb-2 text-base font-bold">
        !
      </div>
      <p class="text-sm font-semibold text-[#0F172A]">Aucun but ne correspond aux filtres sélectionnés</p>
      <p class="text-xs text-[#64748B] mt-1">Réinitialisez vos critères de saison ou de compétition pour voir toutes les réalisations.</p>
    </div>

  </div>
</section>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    let activeComp = 'all';
    let activeSeason = 'all';
    let sortColumn: 'date' | 'minute' | null = null;
    let sortOrder: 'asc' | 'desc' = 'desc';
    let currentPage = 1;
    const itemsPerPage = 6;

    const compButtons = document.querySelectorAll<HTMLButtonElement>('.filter-comp-btn');
    const seasonButtons = document.querySelectorAll<HTMLButtonElement>('.filter-season-btn');
    const rows = Array.from(document.querySelectorAll<HTMLTableRowElement>('.goal-table-row'));
    const counterEl = document.getElementById('filtered-count');
    const noResultsEl = document.getElementById('no-results');
    const triggerButtons = document.querySelectorAll<HTMLButtonElement>('.trigger-butoscope-btn');
    
    const thDate = document.getElementById('th-date');
    const thMinute = document.getElementById('th-minute');
    const sortDateIcon = document.getElementById('sort-date-icon');
    const sortMinuteIcon = document.getElementById('sort-minute-icon');

    const btnPrev = document.getElementById('btn-prev-page') as HTMLButtonElement | null;
    const btnNext = document.getElementById('btn-next-page') as HTMLButtonElement | null;
    const pageNumbersContainer = document.getElementById('page-numbers-container');
    const paginationStart = document.getElementById('pagination-start');
    const paginationEnd = document.getElementById('pagination-end');
    const paginationTotal = document.getElementById('pagination-total');
    const tbody = document.getElementById('goals-table-body');

    function updateTable() {
      // 1. Filtrer
      const filteredRows = rows.filter((row) => {
        const rowComp = row.dataset.competition;
        const rowSeason = row.dataset.season;
        const matchComp = activeComp === 'all' || rowComp === activeComp;
        const matchSeason = activeSeason === 'all' || rowSeason === activeSeason;
        return matchComp && matchSeason;
      });

      // 2. Trier
      if (sortColumn) {
        filteredRows.sort((a, b) => {
          if (sortColumn === 'date') {
            const dateA = new Date(a.dataset.date || '').getTime();
            const dateB = new Date(b.dataset.date || '').getTime();
            return sortOrder === 'asc' ? dateA - dateB : dateB - dateA;
          } else if (sortColumn === 'minute') {
            const minA = Number(a.dataset.minute) || 0;
            const minB = Number(b.dataset.minute) || 0;
            return sortOrder === 'asc' ? minA - minB : minB - minA;
          }
          return 0;
        });
      }

      // 3. Paginer
      const totalFiltered = filteredRows.length;
      const totalPages = Math.ceil(totalFiltered / itemsPerPage) || 1;
      if (currentPage > totalPages) currentPage = totalPages;
      if (currentPage < 1) currentPage = 1;

      const startIndex = (currentPage - 1) * itemsPerPage;
      const endIndex = Math.min(startIndex + itemsPerPage, totalFiltered);
      const visibleRows = filteredRows.slice(startIndex, endIndex);

      // Mettre à jour l'affichage dans le DOM
      rows.forEach((r) => r.remove()); // Dégager temporairement
      visibleRows.forEach((r, idx) => {
        // Appliquer l'alternance blanc / gris très clair
        r.classList.remove('bg-white', 'bg-[#F8FAFC]/75');
        if (idx % 2 === 0) {
          r.classList.add('bg-white');
        } else {
          r.classList.add('bg-[#F8FAFC]/75');
        }
        tbody?.appendChild(r);
      });

      // Mettre à jour les compteurs
      if (counterEl) counterEl.textContent = totalFiltered.toString();
      if (paginationStart) paginationStart.textContent = totalFiltered === 0 ? '0' : (startIndex + 1).toString();
      if (paginationEnd) paginationEnd.textContent = endIndex.toString();
      if (paginationTotal) paginationTotal.textContent = totalFiltered.toString();

      // État des boutons pagination
      if (btnPrev) btnPrev.disabled = currentPage <= 1;
      if (btnNext) btnNext.disabled = currentPage >= totalPages;

      // Générer les numéros de page
      if (pageNumbersContainer) {
        pageNumbersContainer.innerHTML = '';
        for (let i = 1; i <= totalPages; i++) {
          const pageBtn = document.createElement('button');
          pageBtn.type = 'button';
          pageBtn.textContent = i.toString();
          pageBtn.className = `w-7 h-7 rounded text-xs font-semibold transition-colors ${
            i === currentPage
              ? 'bg-[#004D98] text-white'
              : 'border border-[#E2E8F0] bg-white text-[#475569] hover:bg-[#F1F5F9]'
          }`;
          pageBtn.addEventListener('click', () => {
            currentPage = i;
            updateTable();
          });
          pageNumbersContainer.appendChild(pageBtn);
        }
      }

      if (noResultsEl) {
        if (totalFiltered === 0) {
          noResultsEl.classList.remove('hidden');
        } else {
          noResultsEl.classList.add('hidden');
        }
      }
    }

    // Gestion du filtre Compétition
    compButtons.forEach((btn) => {
      btn.addEventListener('click', () => {
        compButtons.forEach((b) => {
          b.classList.remove('bg-[#004D98]', 'text-white', 'shadow-2xs');
          b.classList.add('bg-[#F8FAFC]', 'text-[#475569]', 'border', 'border-[#E2E8F0]');
        });
        btn.classList.add('bg-[#004D98]', 'text-white', 'shadow-2xs');
        btn.classList.remove('bg-[#F8FAFC]', 'text-[#475569]', 'border', 'border-[#E2E8F0]');

        activeComp = btn.dataset.filterCompetition || 'all';
        currentPage = 1;
        updateTable();
      });
    });

    // Gestion du filtre Saison
    seasonButtons.forEach((btn) => {
      btn.addEventListener('click', () => {
        seasonButtons.forEach((b) => {
          b.classList.remove('bg-[#004D98]', 'text-white', 'shadow-2xs');
          b.classList.add('bg-[#F8FAFC]', 'text-[#475569]', 'border', 'border-[#E2E8F0]');
        });
        btn.classList.add('bg-[#004D98]', 'text-white', 'shadow-2xs');
        btn.classList.remove('bg-[#F8FAFC]', 'text-[#475569]', 'border', 'border-[#E2E8F0]');

        activeSeason = btn.dataset.filterSeason || 'all';
        currentPage = 1;
        updateTable();
      });
    });

    // Tri par date
    thDate?.addEventListener('click', () => {
      if (sortColumn === 'date') {
        sortOrder = sortOrder === 'asc' ? 'desc' : 'asc';
      } else {
        sortColumn = 'date';
        sortOrder = 'desc';
      }
      if (sortDateIcon) sortDateIcon.textContent = sortOrder === 'asc' ? '↑' : '↓';
      if (sortMinuteIcon) sortMinuteIcon.textContent = '↕';
      updateTable();
    });

    // Tri par minute
    thMinute?.addEventListener('click', () => {
      if (sortColumn === 'minute') {
        sortOrder = sortOrder === 'asc' ? 'desc' : 'asc';
      } else {
        sortColumn = 'minute';
        sortOrder = 'asc';
      }
      if (sortMinuteIcon) sortMinuteIcon.textContent = sortOrder === 'asc' ? '↑' : '↓';
      if (sortDateIcon) sortDateIcon.textContent = '↕';
      updateTable();
    });

    // Pagination
    btnPrev?.addEventListener('click', () => {
      if (currentPage > 1) {
        currentPage--;
        updateTable();
      }
    });

    btnNext?.addEventListener('click', () => {
      currentPage++;
      updateTable();
    });

    // Bouton Visualiser au Butoscope
    triggerButtons.forEach((btn) => {
      btn.addEventListener('click', () => {
        const goalId = btn.dataset.triggerGoal;
        if (goalId) {
          window.dispatchEvent(
            new CustomEvent('select-goal', { detail: { goalId } })
          );
        }
      });
    });

    // Initialisation
    updateTable();
  });
</script>
