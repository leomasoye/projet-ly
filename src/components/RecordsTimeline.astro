---
import { getValidatedRecords } from '../lib/data-validator';
import { formatDateFr } from '../lib/utils';

const records = getValidatedRecords();
// Tri chronologique des records
const sortedRecords = [...records].sort(
  (a, b) => new Date(a.date).getTime() - new Date(b.date).getTime()
);
---

<section id="records" class="py-12 sm:py-16 px-4 md:px-8 bg-white border-y border-[#E2E8F0]">
  <div class="max-w-7xl mx-auto">
    
    <!-- En-tête de Section -->
    <div class="flex flex-col md:flex-row md:items-end justify-between gap-4 mb-12">
      <div>
        <div class="flex items-center gap-2 text-xs font-semibold text-[#004D98] uppercase tracking-wider mb-2">
          <span class="w-2 h-2 rounded-full bg-[#004D98]"></span>
          <span>Chronologie Historique</span>
          <span class="text-[#CBD5E1]">•</span>
          <span class="text-[#64748B]">Marqueurs de Précocité</span>
        </div>
        <h2 class="text-2xl sm:text-3xl md:text-4xl font-extrabold text-[#0F172A] tracking-tight leading-none">
          Records de Précocité Mondiaux
        </h2>
        <p class="mt-2 text-sm text-[#64748B] max-w-2xl leading-relaxed">
          Chaque jalon pulvérisé étape par étape. Retrouvez l'âge exact de Lamine Yamal au moment précis où il a réécrit l'histoire du football espagnol, européen et mondial.
        </p>
      </div>

      <div class="bg-[#F8FAFC] border border-[#E2E8F0] px-4 py-2 rounded-lg text-xs font-medium text-[#475569] shadow-xs self-start md:self-auto flex items-center gap-2">
        <span class="text-[#64748B]">Records homologués :</span>
        <span class="font-bold text-[#004D98] text-sm tabular-nums">{records.length} détenus</span>
      </div>
    </div>

    <!-- Axe Chronologique Moderne & Épuré -->
    <div class="relative">
      <!-- Ligne centrale verticale (Desktop) / Ligne gauche (Mobile) -->
      <div class="absolute top-0 bottom-0 left-4 md:left-1/2 w-0.5 bg-[#E2E8F0] -translate-x-1/2 pointer-events-none" aria-hidden="true"></div>

      <div class="space-y-8 md:space-y-10">
        {sortedRecords.map((record, index) => {
          const isEven = index % 2 === 0;

          return (
            <div class={`relative flex flex-col md:flex-row items-start md:items-center ${isEven ? 'md:flex-row-reverse' : ''} group`}>
              
              <!-- Nœud Chronologique Central -->
              <div class="absolute left-4 md:left-1/2 -translate-x-1/2 w-7 h-7 rounded-full bg-white border-2 border-[#004D98] flex items-center justify-center text-xs font-bold text-[#004D98] shadow-sm z-10 group-hover:bg-[#004D98] group-hover:text-white transition-all">
                {index + 1}
              </div>

              <!-- Contenu de la Carte (Largeur 50% sur desktop) -->
              <div class="ml-10 md:ml-0 md:w-1/2 md:px-8 w-full">
                <div class="bg-white rounded-xl border border-[#E2E8F0] p-6 shadow-xs hover:shadow-card-hover transition-all">
                  
                  <!-- Tag Âge Exact en Évidence -->
                  <div class="flex flex-wrap items-center justify-between gap-2 mb-3 pb-3 border-b border-[#E2E8F0]">
                    <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-md text-xs font-semibold bg-[#edf4fb] text-[#004D98] border border-[#004D98]/20">
                      <span class="w-1.5 h-1.5 rounded-full bg-[#004D98]"></span>
                      Âge : {record.exactAge.years} ans et {record.exactAge.days} jours
                    </span>
                    <span class="text-xs text-[#64748B] font-medium">
                      {formatDateFr(record.date)}
                    </span>
                  </div>

                  <!-- Intitulé du Record -->
                  <h3 class="text-lg sm:text-xl font-bold text-[#0F172A] tracking-tight leading-snug mb-2 group-hover:text-[#004D98] transition-colors">
                    {record.title}
                  </h3>

                  <!-- Contexte du Match -->
                  <div class="text-xs text-[#64748B] mb-3 flex items-center gap-2">
                    <span class="font-semibold text-[#A50044] bg-[#fdf2f5] px-2 py-0.5 rounded border border-[#A50044]/15">
                      {record.competition}
                    </span>
                    <span class="text-[#CBD5E1]">•</span>
                    <span class="text-[#475569]">{record.matchContext}</span>
                  </div>

                  <!-- Description -->
                  {record.description && (
                    <p class="text-xs sm:text-sm text-[#475569] leading-relaxed mb-4">
                      {record.description}
                    </p>
                  )}

                  <!-- Statut & Ancien Détenteur -->
                  <div class="pt-3 border-t border-[#E2E8F0] flex flex-wrap items-center justify-between gap-2 text-xs">
                    <div class="flex items-center gap-1.5 text-emerald-700 font-medium">
                      <span class="w-1.5 h-1.5 rounded-full bg-emerald-500"></span>
                      <span>Statut : {record.status}</span>
                    </div>

                    {record.previousHolder && (
                      <div class="text-[#64748B] text-[11px]">
                        Ancien détenteur : <span class="text-[#0F172A] font-semibold">{record.previousHolder}</span>
                      </div>
                    )}
                  </div>

                </div>
              </div>

              <!-- Espace vide symétrique pour l'équilibre desktop -->
              <div class="hidden md:block md:w-1/2"></div>
            </div>
          );
        })}
      </div>
    </div>

  </div>
</section>
