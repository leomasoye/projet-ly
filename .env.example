# ==============================================================================
# VARIABLES D'ENVIRONNEMENT — PROJET LY (LAMINE YAMAL 304)
# ==============================================================================
# AVERTISSEMENT DE SÉCURITÉ :
# - Ne jamais commiter de fichier .env réel contenant des clés de production.
# - Aucune clé privée ne doit comporter le préfixe PUBLIC_ (règle sécurité SSG).
# ==============================================================================

# Clé API Football (Fournisseur : API-Football / RapidAPI ou Football-Data.org)
# Utilisée exclusivement par scripts/fetch-stats.ts et GitHub Actions.
FOOTBALL_API_KEY=votre_cle_api_secrete_ici

# Optionnel : Choix du fournisseur ('api-football' par défaut ou 'football-data')
FOOTBALL_API_PROVIDER=api-football
